{
  "name": "buildanta",
  "private": true,
  "version": "0.1.0",
  "description": "Buildanta construction-materials catalog. Release 1: catalog MVP plus bulk quote requests.",
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @buildanta/api test:integration",
    "test:e2e": "pnpm --filter @buildanta/e2e test:e2e",
    "test:e2e:ui": "pnpm --filter @buildanta/e2e test:e2e:ui",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @buildanta/db generate",
    "db:migrate": "pnpm --filter @buildanta/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @buildanta/db migrate:deploy",
    "db:seed": "pnpm --filter @buildanta/db seed",
    "db:studio": "pnpm --filter @buildanta/db studio",
    "db:reset": "pnpm --filter @buildanta/db reset",
    "setup": "pnpm install && pnpm db:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
