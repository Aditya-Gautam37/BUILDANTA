# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — it is gitignored.
# One .env at the repo root; every app reads from it via dotenv-cli.
# ---------------------------------------------------------------------------

# Postgres.
#
# Local Docker (docker-compose.yml defaults) — no pooler, so both variables point
# at the same connection:
#   DATABASE_URL="postgresql://buildanta:buildanta@localhost:5433/buildanta?schema=public"
#   DIRECT_URL="postgresql://buildanta:buildanta@localhost:5433/buildanta?schema=public"
#
# Supabase — from Project Settings → Database → Connection string:
#   DATABASE_URL = "Connection pooling" string (transaction mode, port 6543).
#                  Used for normal app queries.
#   DIRECT_URL   = "Direct connection" string (port 5432).
#                  Used only by `prisma migrate`; PgBouncer's transaction-mode
#                  pooling does not reliably support the prepared statements a
#                  migration needs.
#
# Both are required — DIRECT_URL has no automatic fallback; Prisma errors if it
# is unset while present in schema.prisma.
DATABASE_URL="postgresql://buildanta:buildanta@localhost:5433/buildanta?schema=public"
DIRECT_URL="postgresql://buildanta:buildanta@localhost:5433/buildanta?schema=public"

# Where the API service listens, and where the web apps reach it.
API_PORT=4000
API_HOST="127.0.0.1"
API_URL="http://localhost:4000"

# Origins allowed to call the API with credentials (comma-separated).
# storefront = 3000, admin = 3001.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Set to "true" ONLY when running behind a proxy that sets x-forwarded-for.
# Enabling it without such a proxy lets clients spoof their IP and defeat the
# login rate limiter.
TRUST_PROXY="false"

# Admin session signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 32 characters. The API refuses to start without it.
SESSION_SECRET=""
SESSION_COOKIE_NAME="buildanta_admin_session"

# Product image storage — Supabase Storage. From Project Settings → API:
#   SUPABASE_URL             = "Project URL" (same project as DATABASE_URL).
#   SUPABASE_SERVICE_ROLE_KEY = "service_role secret". Server-only: never sent to
#                               a browser, and grants full bucket access bypassing
#                               any storage policy — that is why uploads go through
#                               this API and never directly from a web app.
# SUPABASE_STORAGE_BUCKET is created automatically on first API start if it
# doesn't exist yet, as a public bucket (product photos are meant to be publicly
# readable — the same as they were served over plain HTTP in local-disk storage).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# ISO 4217 code used when a variant does not override it.
DEFAULT_CURRENCY="INR"

# Seed credentials for the first admin user (used by `pnpm db:seed` only).
SEED_ADMIN_EMAIL="admin@buildanta.local"
SEED_ADMIN_NAME="Buildanta Admin"
SEED_ADMIN_PASSWORD="change-me-in-development"
